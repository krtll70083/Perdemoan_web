<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Roti Kacang Rajawali – Legenda Kuliner Tebing Tinggi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            amber: { DEFAULT: '#D97706', light: '#F59E0B', dark: '#B45309', pale: '#FEF3C7' },
            burgundy: { DEFAULT: '#7F1D1D', light: '#991B1B', dark: '#450A0A', pale: '#FEE2E2' },
            cream: { DEFAULT: '#FDFBF7', dark: '#F5F0E8' },
          },
          fontFamily: {
            playfair: ['"Playfair Display"', 'serif'],
            poppins: ['Poppins', 'sans-serif'],
          },
        }
      }
    };
  </script>
  <style>
    * { scroll-behavior: smooth; }
    body { font-family: 'Poppins', sans-serif; background-color: #FDFBF7; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; }

    /* Grain texture overlay */
    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
      opacity: 0.4;
    }

    /* Animated underline */
    .animated-underline {
      position: relative;
      display: inline-block;
    }
    .animated-underline::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0;
      width: 100%; height: 3px;
      background: #D97706;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    .animated-underline:hover::after { transform: scaleX(1); }

    /* Eagle watermark */
    .eagle-watermark {
      position: absolute;
      font-size: 280px;
      opacity: 0.04;
      user-select: none;
      pointer-events: none;
      line-height: 1;
    }

    /* Hero gradient */
    .hero-bg {
      background: linear-gradient(135deg, #7F1D1D 0%, #991B1B 30%, #B45309 70%, #D97706 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 70% 50%, rgba(217,119,6,0.3) 0%, transparent 60%);
    }

    /* Diagonal divider */
    .diagonal-bottom {
      clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
    }
    .diagonal-top {
      clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%);
    }

    /* Pulsing WhatsApp */
    @keyframes pulse-wa {
      0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6); }
      50% { box-shadow: 0 0 0 16px rgba(37, 211, 102, 0); }
    }
    .wa-pulse { animation: pulse-wa 2s ease-in-out infinite; }

    /* Timer glow */
    @keyframes timer-glow {
      0%, 100% { text-shadow: 0 0 20px rgba(217,119,6,0.4); }
      50% { text-shadow: 0 0 40px rgba(217,119,6,0.9), 0 0 60px rgba(217,119,6,0.4); }
    }
    .timer-glow { animation: timer-glow 2s ease-in-out infinite; }

    /* Shimmer badge */
    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    .shimmer-badge {
      background: linear-gradient(90deg, #D97706 0%, #F59E0B 40%, #FBBF24 50%, #F59E0B 60%, #D97706 100%);
      background-size: 200% auto;
      animation: shimmer 3s linear infinite;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Fade-in on scroll */
    .fade-in-section {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-in-section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Section divider wave */
    .wave-divider {
      height: 60px;
      background: #FDFBF7;
      clip-path: ellipse(55% 100% at 50% 0%);
    }

    /* Card hover lift */
    .card-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .card-lift:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(127,29,29,0.15); }

    /* Nav blur */
    .nav-blur {
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
    }

    /* Pattern bg */
    .pattern-bg {
      background-image: 
        radial-gradient(circle at 25% 25%, rgba(217,119,6,0.06) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(127,29,29,0.06) 0%, transparent 50%);
    }

    /* Badge status */
    @keyframes blink-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .blink-dot { animation: blink-dot 1.2s ease-in-out infinite; }

    /* Ornamental lines */
    .ornament {
      display: flex; align-items: center; gap: 12px;
      color: #D97706;
    }
    .ornament::before, .ornament::after {
      content: '';
      flex: 1; height: 1px;
      background: linear-gradient(to right, transparent, #D97706, transparent);
    }

    /* Input focus ring */
    .input-field {
      border: 2px solid #E5E7EB;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .input-field:focus {
      outline: none;
      border-color: #D97706;
      box-shadow: 0 0 0 4px rgba(217,119,6,0.12);
    }

    /* Scroll indicator */
    @keyframes bounce-down {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(8px); }
    }
    .bounce-down { animation: bounce-down 1.5s ease-in-out infinite; }

    /* Stats counter */
    @keyframes count-up { from { opacity: 0; } to { opacity: 1; } }

    /* Premium ribbon */
    .ribbon {
      position: absolute;
      top: 20px; right: -8px;
      background: #7F1D1D;
      color: white;
      padding: 4px 16px 4px 12px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
    }
    .ribbon::before {
      content: '';
      position: absolute;
      bottom: -8px; right: 0;
      border-width: 8px 8px 0 0;
      border-style: solid;
      border-color: #450A0A transparent transparent transparent;
    }
  </style>
</head>
<body class="text-gray-800 overflow-x-hidden">

<!-- ===== NAVIGATION ===== -->
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 nav-blur" style="background: rgba(127,29,29,0.92);">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-amber flex items-center justify-center text-white font-bold text-xl shadow-lg" style="font-family: 'Playfair Display', serif;">R</div>
      <div>
        <div class="text-white font-bold text-sm leading-tight" style="font-family: 'Playfair Display', serif;">Rajawali</div>
        <div class="text-amber-light text-xs font-light tracking-widest">TEBING TINGGI • EST. 1985</div>
      </div>
    </div>
    <!-- Nav Links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#tracker" class="text-amber-light text-sm font-medium animated-underline hover:text-white transition-colors">Fresh Tracker</a>
      <a href="#reseller" class="text-amber-light text-sm font-medium animated-underline hover:text-white transition-colors">B2B Reseller</a>
      <a href="#verifikasi" class="text-amber-light text-sm font-medium animated-underline hover:text-white transition-colors">Verifikasi</a>
      <a href="https://wa.me/628126346681?text=Halo%20Rajawali%2C%20saya%20ingin%20melakukan%20pemesanan." target="_blank"
         class="bg-amber text-white text-sm font-semibold px-5 py-2 rounded-full hover:bg-amber-dark transition-all hover:shadow-lg">
        Pesan Sekarang
      </a>
    </div>
  </div>
</nav>

<!-- ===== HERO SECTION ===== -->
<section class="hero-bg diagonal-bottom min-h-screen flex items-center pt-20 pb-32">
  <!-- Decorative eagle watermark -->
  <div class="eagle-watermark" style="right: -40px; top: 50%; transform: translateY(-50%); color: white;">🦅</div>
  <div class="eagle-watermark" style="left: -80px; bottom: -20px; color: white; font-size: 200px;">🦅</div>

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    <!-- Left: Text -->
    <div class="relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white bg-opacity-15 backdrop-blur-sm border border-white border-opacity-20 rounded-full px-4 py-2 mb-8">
        <span class="w-2 h-2 rounded-full bg-green-400 blink-dot"></span>
        <span class="text-white text-xs font-medium tracking-wider">DAPUR AKTIF • PRODUKSI HARIAN</span>
      </div>

      <h1 class="text-white text-5xl lg:text-6xl xl:text-7xl font-black leading-tight mb-6" style="font-family: 'Playfair Display', serif; text-shadow: 0 4px 24px rgba(0,0,0,0.3);">
        Cita Rasa<br/>
        <span class="italic text-amber-light">Legendaris</span><br/>
        Tebing Tinggi,<br/>
        <span class="text-4xl lg:text-5xl font-bold not-italic">Kini Lebih Dekat.</span>
      </h1>

      <p class="text-amber-pale text-base lg:text-lg leading-relaxed mb-10 max-w-xl font-light">
        Warisan kuliner sejak <strong class="text-white font-semibold">1985</strong> — dipanggang segar setiap hari dari bahan pilihan terbaik. Kini hadir dengan sistem pemesanan modern untuk seluruh Nusantara, langsung dari dapur leluhur kami.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4">
        <a href="#tracker" class="group bg-amber text-white font-semibold px-8 py-4 rounded-full text-base hover:bg-amber-light transition-all hover:shadow-2xl hover:scale-105 flex items-center gap-2">
          <span>🔥</span>
          Lihat Status Dapur
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="#reseller" class="group bg-white bg-opacity-10 border-2 border-white border-opacity-40 text-white font-semibold px-8 py-4 rounded-full text-base hover:bg-white hover:text-burgundy transition-all flex items-center gap-2">
          <span>📦</span>
          Kalkulator Reseller
        </a>
      </div>

      <!-- Stats row -->
      <div class="flex gap-8 mt-12 pt-8 border-t border-white border-opacity-20">
        <div>
          <div class="text-white text-2xl font-bold" style="font-family: 'Playfair Display', serif;">38+</div>
          <div class="text-amber-pale text-xs">Tahun Beroperasi</div>
        </div>
        <div>
          <div class="text-white text-2xl font-bold" style="font-family: 'Playfair Display', serif;">500+</div>
          <div class="text-amber-pale text-xs">Reseller Aktif</div>
        </div>
        <div>
          <div class="text-white text-2xl font-bold" style="font-family: 'Playfair Display', serif;">34</div>
          <div class="text-amber-pale text-xs">Provinsi Jangkauan</div>
        </div>
      </div>
    </div>

    <!-- Right: Product showcase card -->
    <div class="relative flex justify-center lg:justify-end">
      <div class="relative w-full max-w-sm">
        <!-- Glow behind card -->
        <div class="absolute inset-0 bg-amber opacity-20 rounded-3xl blur-3xl transform scale-110"></div>

        <div class="relative bg-white bg-opacity-10 backdrop-blur-md border border-white border-opacity-20 rounded-3xl p-8 text-center shadow-2xl">
          <!-- Product image placeholder with icon -->
          <div class="w-40 h-40 mx-auto mb-6 rounded-full bg-gradient-to-br from-amber-light to-amber flex items-center justify-center shadow-xl text-7xl">
            🍞
          </div>

          <div class="text-white text-sm font-light tracking-widest mb-1">PRODUK UNGGULAN</div>
          <h3 class="text-white text-2xl font-bold mb-2" style="font-family: 'Playfair Display', serif;">Roti Kacang Spesial</h3>
          <p class="text-amber-pale text-sm mb-6">Isian kacang pilihan, adonan lembut, dipanggang sempurna setiap pagi</p>

          <!-- Tags -->
          <div class="flex flex-wrap justify-center gap-2 mb-6">
            <span class="bg-amber bg-opacity-30 text-amber-pale text-xs px-3 py-1 rounded-full border border-amber border-opacity-40">🌾 Non-Pengawet</span>
            <span class="bg-amber bg-opacity-30 text-amber-pale text-xs px-3 py-1 rounded-full border border-amber border-opacity-40">🔥 Dipanggang Segar</span>
            <span class="bg-amber bg-opacity-30 text-amber-pale text-xs px-3 py-1 rounded-full border border-amber border-opacity-40">📦 Siap Cargo</span>
          </div>

          <div class="text-amber-light text-3xl font-black" style="font-family: 'Playfair Display', serif;">Rp 45.000<span class="text-base font-normal text-white opacity-70">/kotak</span></div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 translate-y-16 text-white text-center">
        <div class="text-xs tracking-widest opacity-60 mb-2">SCROLL</div>
        <div class="bounce-down text-xl opacity-60">↓</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== HERITAGE STRIP ===== -->
<section class="bg-amber py-5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-8 text-white text-sm font-medium tracking-wider">
