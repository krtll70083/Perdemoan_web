</section>

<!-- ===== GEBRAKAN 1: FRESH TRACKER ===== -->
<section id="tracker" class="py-24 pattern-bg relative overflow-hidden">
  <div class="eagle-watermark" style="right: -60px; top: 50%; transform: translateY(-50%); opacity: 0.03;">🦅</div>

  <div class="max-w-7xl mx-auto px-6">

    <!-- Section Header -->
    <div class="text-center mb-16 fade-in-section">
      <div class="ornament mb-4 text-xs tracking-widest font-semibold text-amber">GEBRAKAN 01</div>
      <h2 class="text-burgundy text-4xl lg:text-5xl font-black mb-4" style="font-family: 'Playfair Display', serif;">
        Rajawali <span class="italic text-amber">Fresh-Tracker</span>
      </h2>
      <p class="text-gray-500 max-w-xl mx-auto text-base">Pantau langsung status pemanggangan roti kami secara real-time. Transparansi penuh dari dapur ke tangan Anda.</p>
    </div>

    <!-- Main Tracker Dashboard -->
    <div class="max-w-3xl mx-auto fade-in-section">
      <div class="relative bg-burgundy rounded-3xl overflow-hidden shadow-2xl">
        <!-- Top accent line -->
        <div class="h-1.5 bg-gradient-to-r from-amber-dark via-amber-light to-amber-dark"></div>

        <div class="p-8 lg:p-12">
          <!-- Header -->
          <div class="flex items-center justify-between mb-10">
            <div>
              <div class="text-amber text-xs tracking-widest font-semibold mb-1">DAPUR PUSAT — TEBING TINGGI</div>
              <h3 class="text-white text-2xl font-bold" style="font-family: 'Playfair Display', serif;">Status Produksi Live</h3>
            </div>
            <div class="text-right">
              <div class="flex items-center gap-2 justify-end mb-1">
                <span class="w-2.5 h-2.5 rounded-full bg-green-400 blink-dot"></span>
                <span class="text-green-400 text-sm font-semibold">ONLINE</span>
              </div>
              <div class="text-white text-opacity-50 text-xs" id="live-time">--:--:--</div>
            </div>
          </div>

          <!-- Batch Status Badge -->
          <div class="text-center mb-8">
            <div id="batch-badge"
                 class="inline-block bg-amber bg-opacity-20 border-2 border-amber rounded-2xl px-8 py-4 text-amber font-black text-xl lg:text-2xl tracking-wider"
                 style="font-family: 'Playfair Display', serif;">
              BATCH 03: SEDANG DIPANGGANG 🔥
            </div>
          </div>

          <!-- Timer Display -->
          <div class="text-center mb-10">
            <div class="text-white text-xs tracking-widest mb-3 opacity-60">ESTIMASI MATANG DALAM</div>
            <div id="countdown-timer" class="text-amber text-7xl lg:text-8xl font-black timer-glow tabular-nums" style="font-family: 'Playfair Display', serif; letter-spacing: -2px;">
              15:00
            </div>
            <div class="text-white text-opacity-40 text-sm mt-2">menit : detik</div>
          </div>

          <!-- Progress Bar -->
          <div class="mb-10">
            <div class="flex justify-between text-xs text-white text-opacity-50 mb-2">
              <span>Mulai Dipanggang</span>
              <span id="progress-percent">0%</span>
              <span>Matang & Siap</span>
            </div>
            <div class="h-3 bg-white bg-opacity-10 rounded-full overflow-hidden">
              <div id="progress-bar"
                   class="h-full rounded-full transition-all duration-1000"
                   style="width: 0%; background: linear-gradient(90deg, #B45309, #D97706, #F59E0B);">
              </div>
            </div>
          </div>

          <!-- Step indicators -->
          <div class="grid grid-cols-4 gap-3">
            <div class="step-indicator text-center" data-step="1">
              <div class="step-dot w-10 h-10 mx-auto mb-2 rounded-full bg-amber flex items-center justify-center text-white text-lg">🌾</div>
              <div class="text-white text-opacity-70 text-xs">Adonan<br/>Disiapkan</div>
            </div>
            <div class="step-indicator text-center" data-step="2">
              <div id="step2-dot" class="step-dot w-10 h-10 mx-auto mb-2 rounded-full bg-white bg-opacity-20 flex items-center justify-center text-white text-lg">🥜</div>
              <div class="text-white text-opacity-70 text-xs">Isian<br/>Kacang</div>
            </div>
            <div class="step-indicator text-center" data-step="3">
              <div id="step3-dot" class="step-dot w-10 h-10 mx-auto mb-2 rounded-full bg-white bg-opacity-20 flex items-center justify-center text-white text-lg">🔥</div>
              <div class="text-white text-opacity-70 text-xs">Proses<br/>Pemanggangan</div>
            </div>
            <div class="step-indicator text-center" data-step="4">
              <div id="step4-dot" class="step-dot w-10 h-10 mx-auto mb-2 rounded-full bg-white bg-opacity-20 flex items-center justify-center text-white text-lg">📦</div>
              <div class="text-white text-opacity-70 text-xs">Siap<br/>Dikirim</div>
            </div>
          </div>
        </div>

        <!-- Bottom info strip -->
        <div class="bg-black bg-opacity-30 px-8 py-4 flex flex-wrap gap-4 justify-between items-center">
          <div class="text-white text-opacity-60 text-xs">Oven: Suhu <span class="text-amber font-semibold">180°C</span></div>
          <div class="text-white text-opacity-60 text-xs">Total unit batch ini: <span class="text-amber font-semibold">120 kotak</span></div>
          <div class="text-white text-opacity-60 text-xs">Jadwal batch berikutnya: <span class="text-amber font-semibold">BATCH 04 — 14:00 WIB</span></div>
        </div>
      </div>

      <!-- Quick order prompt -->
      <div class="mt-6 bg-amber-pale border border-amber border-opacity-30 rounded-2xl p-5 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-3">
          <span class="text-2xl">💡</span>
          <div>
            <div class="font-semibold text-burgundy text-sm">Pre-order sebelum batch matang!</div>
            <div class="text-gray-500 text-xs">Dapatkan prioritas pengiriman untuk batch ini</div>
          </div>
        </div>
        <a href="https://wa.me/628126346681?text=Halo%2C%20saya%20ingin%20pre-order%20Batch%2003%20Roti%20Kacang%20Rajawali." target="_blank"
           class="bg-burgundy text-white text-sm font-semibold px-6 py-2.5 rounded-full hover:bg-burgundy-light transition-all whitespace-nowrap">
          Pre-order via WhatsApp →
        </a>
      </div>
    </div>
  </div>
</section>

