<!-- ===== GEBRAKAN 2: B2B RESELLER CALCULATOR ===== -->
<section id="reseller" class="py-24 bg-cream relative overflow-hidden">
  <div class="eagle-watermark" style="left: -60px; bottom: -20px; opacity: 0.025;">🦅</div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16 fade-in-section">
      <div class="ornament mb-4 text-xs tracking-widest font-semibold text-amber">GEBRAKAN 02</div>
      <h2 class="text-burgundy text-4xl lg:text-5xl font-black mb-4" style="font-family: 'Playfair Display', serif;">
        B2B Reseller &amp; <span class="italic text-amber">Cargo Calculator</span>
      </h2>
      <p class="text-gray-500 max-w-xl mx-auto text-base">Hitung keuntungan bisnis Anda secara instan. Semakin banyak pesan, semakin besar margin profit Anda.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-start max-w-5xl mx-auto">
      <!-- Input Form -->
      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden fade-in-section">
        <div class="bg-burgundy px-8 py-6">
          <div class="text-amber text-xs font-semibold tracking-widest mb-1">FORMULIR PERHITUNGAN</div>
          <h3 class="text-white text-xl font-bold" style="font-family: 'Playfair Display', serif;">Detail Pemesanan Grosir</h3>
        </div>

        <div class="p-8">
