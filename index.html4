   title="Chat via WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-8 h-8">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
  <!-- Label -->
  <div class="absolute right-full mr-3 bg-white text-green-600 text-xs font-bold px-3 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 hover-label transition-opacity">
    Chat WhatsApp
  </div>
</a>

<!-- ===== JAVASCRIPT ===== -->
<script>
  // =============================
  // 1. LIVE CLOCK
  // =============================
  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2,'0');
    const m = String(now.getMinutes()).padStart(2,'0');
    const s = String(now.getSeconds()).padStart(2,'0');
    const el = document.getElementById('live-time');
    if (el) el.textContent = `${h}:${m}:${s} WIB`;
  }
  setInterval(updateClock, 1000);
  updateClock();

  // =============================
  // 2. FRESH TRACKER COUNTDOWN
  // =============================
  const TOTAL_SECONDS = 15 * 60; // 15 minutes
  let secondsLeft = TOTAL_SECONDS;
  let isBaking = true;

  function updateTimer() {
    secondsLeft--;
    if (secondsLeft < 0) {
      // Reset cycle
      secondsLeft = TOTAL_SECONDS;
      isBaking = true;
    }

    const elapsed = TOTAL_SECONDS - secondsLeft;
    const progressPct = Math.round((elapsed / TOTAL_SECONDS) * 100);

    // Update display
    const mins = Math.floor(secondsLeft / 60);
    const secs = secondsLeft % 60;
    const display = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    document.getElementById('countdown-timer').textContent = display;

    // Update progress bar
    document.getElementById('progress-bar').style.width = progressPct + '%';
    document.getElementById('progress-percent').textContent = progressPct + '%';

    // Update batch badge and steps
    const badge = document.getElementById('batch-badge');

    if (secondsLeft <= 0 || secondsLeft === TOTAL_SECONDS) {
      // Just reset — matang
      badge.className = 'inline-block border-2 rounded-2xl px-8 py-4 font-black text-xl lg:text-2xl tracking-wider';
      badge.style.background = 'rgba(16,185,129,0.2)';
      badge.style.borderColor = 'rgb(16,185,129)';
      badge.style.color = 'rgb(52,211,153)';
      badge.textContent = 'BATCH 03: MATANG & SIAP DIKIRIM! 🎉';
      setStepActive(4);
    } else {
      badge.className = 'inline-block bg-amber bg-opacity-20 border-2 border-amber rounded-2xl px-8 py-4 text-amber font-black text-xl lg:text-2xl tracking-wider';
      badge.style.background = '';
      badge.style.borderColor = '';
      badge.style.color = '';
      badge.textContent = 'BATCH 03: SEDANG DIPANGGANG 🔥';

      if (progressPct < 25) setStepActive(1);
      else if (progressPct < 50) setStepActive(2);
      else if (progressPct < 90) setStepActive(3);
    }
  }

  function setStepActive(step) {
    const dots = ['step2-dot','step3-dot','step4-dot'];
    const colors = ['bg-amber','bg-white bg-opacity-20'];
    dots.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (i + 2 <= step) {
        el.className = el.className.replace('bg-white bg-opacity-20', '').trim();
        if (!el.className.includes('bg-amber')) el.className += ' bg-amber';
      } else {
        el.className = el.className.replace('bg-amber', '').trim();
        if (!el.className.includes('bg-white bg-opacity-20')) el.className += ' bg-white bg-opacity-20';
      }
    });
  }

  setInterval(updateTimer, 1000);

  // =============================
  // 3. RESELLER CALCULATOR
  // =============================
  const kargoNames = {
    'jnt': 'J&T Cargo (Rekomendasi Roti)',
    'als': 'Bus ALS Lintas Sumatera',
    'tiki': 'Titipan Kilat (Tiki)'
  };

  function formatRupiah(n) {
    return 'Rp ' + Number(n).toLocaleString('id-ID');
  }

  function calculateReseller() {
    const qty = parseInt(document.getElementById('jumlah_kotak').value) || 0;
    const kargo = document.getElementById('pilihan_kargo').value;

    let pricePerBox = 45000;
    let bonusText = '';
    let tierBadgeText = '';
    let tierBadgeClass = '';

    if (qty >= 100) {
      pricePerBox = 37000;
      bonusText = '📦 Bonus Packing Peti Kayu Aman (Anti Hancur)';
      tierBadgeText = '🏆 ANDA MASUK LEVEL RESELLER GOLD!';
      tierBadgeClass = 'bg-amber text-white';
    } else if (qty >= 20) {
      pricePerBox = 40000;
      bonusText = '🎁 Bonus Free Bubble Wrap + Stiker Reseller';
      tierBadgeText = '🥈 ANDA MASUK LEVEL RESELLER SILVER!';
      tierBadgeClass = 'bg-gray-400 text-white';
    }

    const totalHarga = qty * pricePerBox;
    const totalBerat = (qty * 0.5).toFixed(1);

    // Update DOM
    document.getElementById('harga-per-kotak').textContent = formatRupiah(pricePerBox);
    document.getElementById('display-kotak').textContent = qty > 0 ? qty + ' kotak' : '—';
    document.getElementById('total-berat').textContent = qty > 0 ? totalBerat + ' Kg' : '— Kg';
    document.getElementById('total-harga').textContent = qty > 0 ? formatRupiah(totalHarga) : 'Rp 0';
    document.getElementById('display-kargo').textContent = kargo ? kargoNames[kargo] : '—';

    // Tier badge
    const tierEl = document.getElementById('tier-badge');
    if (tierBadgeText && qty > 0) {
      tierEl.className = `mb-4 text-center py-3 rounded-2xl font-bold text-base tracking-wide transition-all ${tierBadgeClass}`;
      tierEl.textContent = tierBadgeText;
      tierEl.classList.remove('hidden');
    } else {
      tierEl.classList.add('hidden');
    }

    // Bonus box
    const bonusEl = document.getElementById('bonus-info');
    if (bonusText && qty > 0) {
      bonusEl.className = 'rounded-2xl p-4 text-sm font-medium bg-green-50 border border-green-200 text-green-700';
      bonusEl.textContent = bonusText;
      bonusEl.classList.remove('hidden');
    } else {
      bonusEl.classList.add('hidden');
    }

    // WhatsApp link
    if (qty > 0) {
      const waMsg = encodeURIComponent(`Halo Rajawali! Saya ingin memesan:\n\n📦 Jumlah: ${qty} kotak\n💰 Harga/kotak: ${formatRupiah(pricePerBox)}\n🏋️ Total berat: ${totalBerat} Kg\n🚚 Ekspedisi: ${kargo ? kargoNames[kargo] : 'Belum dipilih'}\n💵 Total: ${formatRupiah(totalHarga)}\n\nMohon konfirmasi ketersediaan dan estimasi pengiriman. Terima kasih!`);
      document.getElementById('wa-order-link').href = `https://wa.me/628126346681?text=${waMsg}`;
    }
  }

  // =============================
  // 4. PRODUCT VERIFICATION
  // =============================
  function verifyProduct() {
    const code = document.getElementById('security-code').value.trim();
    const successEl = document.getElementById('verify-success');
    const errorEl = document.getElementById('verify-error');
    const icon = document.getElementById('code-icon');

    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    if (code.toUpperCase() === 'RAJAWALI-ASLI-2026') {
      successEl.classList.remove('hidden');
      errorEl.classList.add('hidden');
      icon.textContent = '✅';
    } else {
      errorEl.classList.remove('hidden');
      successEl.classList.add('hidden');
      icon.textContent = '❌';
    }
  }

  // Also verify on Enter key
  document.getElementById('security-code').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') verifyProduct();
  });

  // =============================
  // 5. SCROLL ANIMATIONS
  // =============================
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));

  // =============================
  // 6. NAVBAR SCROLL EFFECT
  // =============================
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar');
    if (window.scrollY > 80) {
      nav.style.background = 'rgba(45,10,10,0.97)';
      nav.style.boxShadow = '0 4px 30px rgba(0,0,0,0.3)';
    } else {
      nav.style.background = 'rgba(127,29,29,0.92)';
      nav.style.boxShadow = 'none';
    }
  });
</script>

</body>
</html>
